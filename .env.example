RELAY_DATABASE_PATH=data/relay.db
RELAY_AGENT_PROVIDER=deterministic
# Set a key to use an OpenAI-compatible Responses API. Never commit keys.
# RELAY_AGENT_API_KEY=
RELAY_AGENT_MODEL=gpt-5-mini
RELAY_AGENT_BASE_URL=https://api.openai.com/v1
RELAY_AGENT_TIMEOUT_SECONDS=30
RELAY_MAX_INVESTIGATION_STEPS=20
RELAY_MAX_REPEATED_TOOL_CALLS=2
RELAY_MAX_TOOL_RETRIES=1
RELAY_EVALUATION_RESULTS_PATH=evaluation-results.json
RELAY_SEED_DEMO_DATA=true
RELAY_FIXTURE_TELEMETRY_URL=http://localhost:8001
RELAY_TELEMETRY_TIMEOUT_SECONDS=3
RELAY_TELEMETRY_FRESHNESS_SECONDS=60
# RIPE Atlas is read-only; reads of public measurements need no credentials.
RELAY_RIPE_ATLAS_BASE_URL=https://atlas.ripe.net/api/v2
# Optional backend-only key for non-public measurements. Never commit keys.
# RELAY_RIPE_ATLAS_API_KEY=
RELAY_RIPE_ATLAS_TIMEOUT_SECONDS=5
RELAY_RIPE_ATLAS_FRESHNESS_SECONDS=3600
# Existing public measurement IDs to read; leave unset to disable an operation.
# RELAY_RIPE_ATLAS_PING_MEASUREMENT_ID=
# RELAY_RIPE_ATLAS_TRACEROUTE_MEASUREMENT_ID=
# RELAY_RIPE_ATLAS_DNS_MEASUREMENT_ID=
RELAY_RIPESTAT_BASE_URL=https://stat.ripe.net/data
RELAY_RIPESTAT_FRESHNESS_SECONDS=43200
